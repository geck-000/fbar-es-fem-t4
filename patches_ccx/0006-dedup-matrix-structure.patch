+/*  F-barES-FEM-T4: memory-bounded global dedup backends for the matrix
+    structure.
+
+    mastruct.c builds the sparse structure by pushing ONE linked-list entry
+    per (dof,dof) pair of every element onto mast1/next and compressing only
+    afterwards.  The transient list is therefore as large as the SUM of the
+    per-element patterns, while the structure that survives is their UNION.
+
+    For the F-bar ES-FEM U3 volumetric elements those differ by a large
+    factor -- measured on the LCOL4 0.0120 undrained cell, 1.44e9 transient
+    U3 insertions against 6.17e7 distinct U3 dof pairs, ~21x -- because the
+    same pair is produced by ~21 different edges.  The duplication is ACROSS
+    elements: within one element the jj/ll loop already emits each pair
+    exactly once, so a per-element "direct" builder cannot remove any of it.
+
+    These backends dedup the pair stream as it arrives, so peak memory
+    tracks the final structure rather than the transient.  Selected with
+
+      CCX_MASTRUCT_DEDUP = legacy   original linked list (default)
+                           chunk    fixed buffer, radix sort + unique, then
+                                    back-merged into one running sorted run
+                           hash     open-addressing hash set, sorted at end
+
+    CCX_MASTRUCT_BUF=<MB> sizes the chunk buffer (default 1024 MB).
+
+    The element loop and every SPC/MPC branch in mastruct.c are untouched;
+    only the sink the pairs flow into changes.                            */
+
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+#include <time.h>
+#include "CalculiX.h"
+
+#define MSD_LEGACY 0
+#define MSD_CHUNK  1
+#define MSD_HASH   2
+
+/* key = column (0-based, high 32 bits) | row (1-based, low 32 bits);
+   sorting the key sorts by column then row, which is exactly the order
+   jq/irow need.  row >= 1 always, so key 0 is a free empty-slot sentinel. */
+#define MSD_KEY(row,col) ((((uint64_t)(uint32_t)(col))<<32)|(uint32_t)(row))
+
+static int msd_md=-1;
+static int msd_on=0;           /* backend armed for this mastruct() call */
+static ITG msd_neq=0;
+
+static uint64_t *msd_buf=NULL,*msd_scr=NULL;
+static size_t msd_bufn=0,msd_bufcap=0;
+static uint64_t *msd_run=NULL;
+static size_t msd_runn=0,msd_runcap=0;
+
+static uint64_t *msd_tab=NULL;
+static size_t msd_tabn=0,msd_tabmask=0;
+static int msd_tabbits=0;
+
+static double msd_t0=0.0;
+static size_t msd_nadd=0,msd_spills=0;
+
+static double msd_now(void){
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC,&ts);
+  return ts.tv_sec+1.0e-9*ts.tv_nsec;
+}
+
+static long msd_hwm(void){          /* peak RSS in kB */
+  FILE *f=fopen("/proc/self/status","r");
+  char l[256]; long v=0;
+  if(!f) return 0;
+  while(fgets(l,sizeof(l),f)) if(strncmp(l,"VmHWM:",6)==0){sscanf(l+6,"%ld",&v);break;}
+  fclose(f);
+  return v;
+}
+
+int msd_mode(void){
+  const char *e;
+  if(msd_md>=0) return msd_md;
+  e=getenv("CCX_MASTRUCT_DEDUP");
+  if(e==NULL||strcmp(e,"legacy")==0)   msd_md=MSD_LEGACY;
+  else if(strcmp(e,"chunk")==0)        msd_md=MSD_CHUNK;
+  else if(strcmp(e,"hash")==0)         msd_md=MSD_HASH;
+  else{
+    printf(" SPAX: unknown CCX_MASTRUCT_DEDUP=\"%s\", using legacy\n",e);
+    msd_md=MSD_LEGACY;
+  }
+  return msd_md;
+}
+
+int msd_active(void){ return msd_on; }
+
+/* ---------------------------------------------------------------- radix */
+
+static void msd_radix(uint64_t *a,uint64_t *tmp,size_t n){
+  static size_t cnt[65536];
+  uint64_t *src=a,*dst=tmp,*t;
+  int pass,b;
+  size_t i,s,c;
+  for(pass=0;pass<4;pass++){
+    int sh=pass*16;
+    memset(cnt,0,sizeof(cnt));
+    for(i=0;i<n;i++) cnt[(src[i]>>sh)&0xffff]++;
+    s=0;
+    for(b=0;b<65536;b++){c=cnt[b];cnt[b]=s;s+=c;}
+    for(i=0;i<n;i++) dst[cnt[(src[i]>>sh)&0xffff]++]=src[i];
+    t=src;src=dst;dst=t;
+  }
+  /* 4 passes = even number of swaps, result is back in a */
+}
+
+/* ---------------------------------------------------------------- chunk */
+
+static void msd_merge(void){
+  size_t need=msd_runn+msd_bufn,i,j,w,newn;
+  uint64_t v,last=0;
+  int have=0;
+  if(need>msd_runcap){
+    msd_runcap=need;
+    msd_run=(uint64_t *)realloc(msd_run,msd_runcap*sizeof(uint64_t));
+    if(msd_run==NULL){
+      printf("\n *ERROR in mastructdedup: out of memory growing the run to %zu entries\n",need);
+      exit(1);
+    }
+  }
+  /* back-merge run[0..runn) with buf[0..bufn) into run[..need), dropping
+     duplicates; writing downward from need never overtakes either read
+     cursor, so no scratch array is needed */
+  i=msd_runn; j=msd_bufn; w=need;
+  while(i>0||j>0){
+    if(i>0&&(j==0||msd_run[i-1]>=msd_buf[j-1])){
+      v=msd_run[i-1];
+      if(j>0&&msd_buf[j-1]==v) j--;
+      i--;
+    }else{
+      v=msd_buf[j-1]; j--;
+    }
+    if(have&&v==last) continue;
+    msd_run[--w]=v; last=v; have=1;
+  }
+  newn=need-w;
+  memmove(msd_run,msd_run+w,newn*sizeof(uint64_t));
+  msd_runn=newn;
+}
+
+static void msd_spill(void){
+  size_t t,k=0;
+  if(msd_bufn==0) return;
+  msd_radix(msd_buf,msd_scr,msd_bufn);
+  for(t=0;t<msd_bufn;t++) if(k==0||msd_buf[t]!=msd_buf[k-1]) msd_buf[k++]=msd_buf[t];
+  msd_bufn=k;
+  msd_merge();
+  msd_bufn=0;
+  msd_spills++;
+}
+
+/* ----------------------------------------------------------------- hash */
+
+static void msd_hash_alloc(int bits){
+  msd_tabbits=bits;
+  msd_tabmask=((size_t)1<<bits)-1;
+  msd_tab=(uint64_t *)calloc((size_t)1<<bits,sizeof(uint64_t));
+  if(msd_tab==NULL){
+    printf("\n *ERROR in mastructdedup: out of memory for a 2^%d hash table\n",bits);
+    exit(1);
+  }
+}
+
+static void msd_hash_put(uint64_t *tab,size_t mask,int bits,uint64_t key){
+  size_t h=(size_t)((key*0x9E3779B97F4A7C15ULL)>>(64-bits))&mask;
+  while(tab[h]){
+    if(tab[h]==key) return;
+    h=(h+1)&mask;
+  }
+  tab[h]=key;
+}
+
+static void msd_hash_grow(void){
+  uint64_t *old=msd_tab;
+  size_t oldn=(size_t)1<<msd_tabbits,i;
+  msd_hash_alloc(msd_tabbits+1);
+  for(i=0;i<oldn;i++) if(old[i]) msd_hash_put(msd_tab,msd_tabmask,msd_tabbits,old[i]);
+  free(old);
+}
+
+static void msd_hash_add(uint64_t key){
+  size_t h;
+  if((msd_tabn+1)*2>(msd_tabmask+1)) msd_hash_grow();
+  h=(size_t)((key*0x9E3779B97F4A7C15ULL)>>(64-msd_tabbits))&msd_tabmask;
+  while(msd_tab[h]){
+    if(msd_tab[h]==key) return;
+    h=(h+1)&msd_tabmask;
+  }
+  msd_tab[h]=key;
+  msd_tabn++;
+}
+
+/* --------------------------------------------------------------- driver */
+
+void msd_begin(ITG *neq,ITG *nmethod,ITG *iperturb){
+  size_t mb=1024;
+  const char *e;
+  msd_on=0;
+  if(msd_mode()==MSD_LEGACY) return;
+
+  /* the frequency/modal boundary block (neq[1]..neq[2]) still walks
+     ipointer/next directly; leave those methods on the legacy path */
+  if((*nmethod==2)||((*nmethod==4)&&(*iperturb<=1))||
+     ((*nmethod>=5)&&(*nmethod<=7))){
+    printf(" SPAX: CCX_MASTRUCT_DEDUP not applied (nmethod=%" ITGFORMAT
+           " uses the boundary stiffness block), using legacy\n",*nmethod);
+    return;
+  }
+
+  msd_neq=neq[1];
+  msd_nadd=0; msd_spills=0; msd_runn=0; msd_bufn=0; msd_tabn=0;
+  msd_t0=msd_now();
+
+  if(msd_mode()==MSD_CHUNK){
+    if((e=getenv("CCX_MASTRUCT_BUF"))!=NULL){
+      mb=(size_t)atol(e);
+      if(mb<16) mb=16;
+    }
+    msd_bufcap=mb*1024*1024/sizeof(uint64_t);
+    msd_buf=(uint64_t *)malloc(msd_bufcap*sizeof(uint64_t));
+    msd_scr=(uint64_t *)malloc(msd_bufcap*sizeof(uint64_t));
+    if(msd_buf==NULL||msd_scr==NULL){
+      printf("\n *ERROR in mastructdedup: cannot allocate a %zu MB chunk buffer\n",mb);
+      exit(1);
+    }
+    printf(" SPAX: matrix structure via chunked sort-dedup, %zu MB buffer\n",mb);
+  }else{
+    msd_hash_alloc(22);
+    printf(" SPAX: matrix structure via hash-set dedup\n");
+  }
+  msd_on=1;
+}
+
+void msd_add(ITG row,ITG col){
+  uint64_t key=MSD_KEY(row,col);
+  msd_nadd++;
+  if(msd_mode()==MSD_CHUNK){
+    if(msd_bufn==msd_bufcap) msd_spill();
+    msd_buf[msd_bufn++]=key;
+  }else{
+    msd_hash_add(key);
+  }
+}
+
+/* mirrors insert.c: lower triangle, diagonal excluded */
+void msd_insert(ITG *i1,ITG *i2){
+  if(*i1==*i2) return;
+  if(*i1<*i2) msd_add(*i2,*i1-1);
+  else        msd_add(*i1,*i2-1);
+}
+
+/* mirrors insertfreq.c: raw (row,column), no reordering */
+void msd_insertfreq(ITG *i1,ITG *i2){
+  msd_add(*i1,*i2-1);
+}
+
+void msd_finish(ITG **irowp,ITG *jq,ITG *nmastp){
+  ITG *irow=*irowp,col=0,r,c;
+  size_t t,p=0,n;
+  uint64_t *key;
+
+  if(msd_mode()==MSD_CHUNK){
+    msd_spill();
+    key=msd_run; n=msd_runn;
+  }else{
+    size_t i,m=(size_t)1<<msd_tabbits;
+    key=(uint64_t *)malloc((msd_tabn?msd_tabn:1)*sizeof(uint64_t));
+    msd_scr=(uint64_t *)malloc((msd_tabn?msd_tabn:1)*sizeof(uint64_t));
+    if(key==NULL||msd_scr==NULL){
+      printf("\n *ERROR in mastructdedup: out of memory extracting the hash table\n");
+      exit(1);
+    }
+    n=0;
+    for(i=0;i<m;i++) if(msd_tab[i]) key[n++]=msd_tab[i];
+    free(msd_tab); msd_tab=NULL;
+    msd_radix(key,msd_scr,n);
+    free(msd_scr); msd_scr=NULL;
+  }
+
+  RENEW(irow,ITG,n>0?n:1);
+  jq[0]=1;
+  for(t=0;t<n;t++){
+    c=(ITG)(key[t]>>32);
+    r=(ITG)(key[t]&0xffffffffu);
+    while(col<c){jq[col+1]=(ITG)(p+1);col++;}
+    irow[p++]=r;
+  }
+  while(col<msd_neq){jq[col+1]=(ITG)(p+1);col++;}
+
+  printf(" SPAX: structure dedup: %.4e pairs offered, %zu distinct"
+         " (%.1fx), %zu spill(s), %.1f s, peak RSS %.2f GB\n",
+         (double)msd_nadd,n,msd_nadd?(double)msd_nadd/(double)(n?n:1):0.0,
+         msd_spills,msd_now()-msd_t0,msd_hwm()/1048576.0);
+
+  if(msd_mode()==MSD_CHUNK){
+    free(msd_run); msd_run=NULL; msd_runcap=0;
+    free(msd_buf); msd_buf=NULL;
+    free(msd_scr); msd_scr=NULL;
+  }else{
+    free(key);
+  }
+  msd_runn=0; msd_bufn=0; msd_bufcap=0; msd_tabn=0;
+  msd_on=0;
+
+  *irowp=irow;
+  *nmastp=(ITG)p;
+}
