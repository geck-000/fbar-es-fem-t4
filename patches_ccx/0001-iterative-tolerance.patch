-  
-  
+  char            *spax_env;
+
+  /* SPAX: c1 is the convergence criterion -- the iteration stops once the
+     residual max-norm falls below c1 times the mean load, i.e. at 0.5% by
+     default. That is far too loose for periodic homogenisation: it returns an
+     effective modulus 0.15% below the direct-solver answer on the same deck.
+     The `eps` argument is NOT the tolerance (it is overwritten with the final
+     residual on exit and returned), so there was no way to reach this number.
+     Read it from the environment. */
+  if((spax_env=getenv("CCX_ITER_TOL"))!=NULL){
